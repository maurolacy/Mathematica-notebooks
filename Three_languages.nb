Cell[BoxData[
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"s", "+", "si", "+", "sc", "+", "sci"}], "==", "spanish"}], ",",
